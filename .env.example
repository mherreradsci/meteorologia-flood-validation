# Cloud Project de Google Earth Engine ya autenticado (`earthengine
# authenticate`, ver ~/.config/earthengine) que dynamic_world.py usa en
# ee.Initialize(project=...). Copiar a .env (gitignored) y completar con
# el project id real. Sin esto, Dynamic World se reporta como no
# disponible aunque esté prendido en config/regions.yaml.
GEE_PROJECT=
